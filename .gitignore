# [<] autogenerated centralized/assets/generic generic/filesTracked/gitignore
#[why] the global ignore carries `**/.*`, which swallows every dot-path: without this the
#   cross-repo interface file stays untracked and invisible to git status, and control's graph
#   sees no producer for this repo's catalog
.user/
packages.schema.json
__pycache__/
*.pyc
.pytest_cache/
AGENTS.md
CLAUDE.md
assets/docs-agents/
/shared/
