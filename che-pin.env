##[>] 🤖🤖
#[what] the che release this catalog targets: the binary the install tests drive. Raise it after che
#   ships new catalog vocabulary, never before: content may only use terms this che understands.
#[why] a floor, not an absolute: on a merge-request pipeline ci/resolve-che-version.zsh overrides
#   both values below with an open go-modules MR's 0.0.0-mr<iid> prerelease, so a catalog change
#   depending on unmerged vocabulary can be proven before that che ships. Default-branch and tag
#   pipelines, which release, always use exactly what is written here.
CHE_VERSION=latest

#[what] the packages schema version validation runs against, an artifact published by go-modules and
#   fetched from the generic package registry by version.
#[why] a version, never a moving git ref: a merged-but-unreleased che vocabulary change must not
#   silently change what this catalog validates against.
#[why] overridden together with CHE_VERSION, never alone: validating against one che's vocabulary
#   while installing another's proves nothing about either.
#[why] the only pin declared here, never in .env or a job variable: make gives a makefile assignment
#   precedence over the environment, so a second source would be read by the artifact declarations
#   while this one silently won every fetch. CHE_SCHEMA_REF, which only the editor header needs,
#   lives in .env and CI instead.
CHE_PACKAGES_SCHEMA_REF=v0.0.1-che-min-v0.0.96
##[<] 🤖🤖
