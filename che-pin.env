##[>] 🤖🤖
#[what] the che release this catalog targets: the binary the install tests drive, and the
#   source of the packages schema validation runs against. Raise it after che ships new
#   catalog vocabulary, never before: content may only use terms this che understands.
#[why] a floor, not an absolute: on a merge-request pipeline ci/resolve-che-version.zsh
#   overrides both values below with an open go-modules MR's 0.0.0-mr<iid> prerelease, so a
#   catalog change depending on unmerged vocabulary can be proven before that che ships.
#   Default-branch and tag pipelines, which release, always use exactly what is written here.
CHE_VERSION=latest

#[what] the git ref the packages schema is read from, che's source of that vocabulary.
#[why] main, not a tag: che publishes no schema to the package registry, and the catalog
#   tracks the vocabulary che has merged.
#[why] overridden together with CHE_VERSION, never alone: validating against one che's
#   vocabulary while installing another's proves nothing about either.
CHE_SCHEMA_REF=main
##[<] 🤖🤖
